page {
  background: #f6f5ef;
  color: #303d35;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 32rpx;
  line-height: 1.7;
}
.page { padding: 44rpx 40rpx 60rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.eyebrow { display: block; font-size: 24rpx; color: #647264; letter-spacing: 3rpx; }
.title { display: block; font-size: 56rpx; font-weight: 500; line-height: 1.35; margin: 20rpx 0 28rpx; }
.muted { color: #687369; }
.paragraph { display: block; margin: 20rpx 0; }
.small { font-size: 26rpx; }
button { font-size: 30rpx; font-weight: 400; border-radius: 16rpx; margin: 0; white-space: normal; }
button::after { border: 0; }
.primary { background: #526b57; color: #fff; padding: 24rpx 30rpx; line-height: 1.5; min-height: 96rpx; }
.secondary { background: #e9ece2; color: #3e5743; padding: 22rpx 30rpx; line-height: 1.5; min-height: 92rpx; }
.text-button { background: transparent; color: #526b57; padding: 22rpx 0; line-height: 1.5; min-height: 88rpx; text-align: left; }
.pressed { opacity: .72; }
.button-stack { display: flex; flex-direction: column; gap: 20rpx; margin-top: 40rpx; }
.notice { padding: 24rpx 0; color: #874e37; font-size: 28rpx; }
textarea { box-sizing: border-box; width: 100%; height: 300rpx; padding: 26rpx; background: #eeeee5; border-radius: 16rpx; font-size: 32rpx; line-height: 1.7; }
.field-label { display: block; margin: 36rpx 0 16rpx; }
.empty { padding: 72rpx 0; }
.divider { border-top: 1rpx solid #dadfd3; margin-top: 48rpx; padding-top: 28rpx; }
